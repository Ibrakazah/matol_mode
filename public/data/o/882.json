{"m882-1":{"skills":[],"hints":[],"solution":"","answer":null,"comments":[{"author":"Ardak","votes":2,"level":0,"html":"<p>$\\frac{1}{a_n + 1} = \\frac{a_n-1}{a_n^2 - 1}= \\frac{a_n+1-2}{a_n^2 - 1} = \\frac{1}{a_n - 1} - \\frac{2}{a_n^2 - 1} = \\frac{1}{a_n-1} - \\frac{1}{a_{n+1} -1}.$</p><p></p><p>$S=(\\frac{1}{a_1-1} - \\frac{1}{a_{2} -1})+(\\frac{1}{a_2-1} - \\frac{1}{a_{3} -1}) ...+(\\frac{1}{a_n-1} - \\frac{1}{a_{n+1} -1})=$</p><p></p><p>$=\\frac{1}{a_1-1} - \\frac{1}{a_{n+1} -1}=\\frac{1}{2} - \\frac{1}{a_{n+1} -1}&lt;\\frac{1}{2}$</p>"}],"cid":4097},"m882-2":{"skills":[],"hints":[],"solution":"","answer":null,"comments":[],"cid":4098},"m882-3":{"skills":[],"hints":[],"solution":"","answer":null,"comments":[],"cid":4099},"m882-4":{"skills":[],"hints":[],"solution":"","answer":null,"comments":[],"cid":4100},"m882-5":{"skills":[],"hints":[],"solution":"","answer":null,"comments":[],"cid":4101},"m882-6":{"skills":[],"hints":[],"solution":"","answer":null,"comments":[],"cid":4102}}